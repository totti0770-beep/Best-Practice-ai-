#!/bin/sh
# Gradle wrapper script for Unix systems

##############################################################################
# Resolve the script directory
##############################################################################
APP_HOME=$(cd "$(dirname "$0")" && pwd)
APP_NAME="Gradle"

##############################################################################
# JVM options
##############################################################################
# Must not contain embedded quotes: the expansion below is intentionally
# unquoted so it word-splits into separate arguments. With quotes inside the
# value, java receives the literal string "-Xmx64m" and reports
# 'Could not find or load main class "-Xmx64m"'.
DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"

JAVACMD=${JAVA_HOME:+$JAVA_HOME/bin/java}
JAVACMD=${JAVACMD:-java}

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

##############################################################################
# Execute Gradle
##############################################################################
exec "$JAVACMD" \
  $DEFAULT_JVM_OPTS \
  $JAVA_OPTS \
  $GRADLE_OPTS \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
